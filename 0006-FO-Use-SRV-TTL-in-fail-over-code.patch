+static void check_server(struct fo_server *srv, int port, const char *name)
+{
+    assert_non_null(srv);
+    assert_true(fo_is_srv_lookup(srv));
+    assert_int_equal(fo_get_server_port(srv), port);
+    assert_string_equal(fo_get_server_name(srv), name);
+}
