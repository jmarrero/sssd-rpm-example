+/* The unit test */
+struct test_fo_srv_ctx {
+    struct resolv_ctx *resolv;
+    struct fo_ctx *fo_ctx;
+    struct fo_resolve_srv_dns_ctx *srv_ctx;
+    struct fo_service *fo_svc;
