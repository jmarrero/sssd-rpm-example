 src/man/Makefile.am      |  4 +++
 src/man/po/po4a.cfg      |  1 +
 src/man/sssd-files.5.xml | 88 ++++++++++++++++++++++++++++++++++++++++++++++++
 4 files changed, 94 insertions(+)
 create mode 100644 src/man/sssd-files.5.xml

diff --git a/contrib/sssd.spec.in b/contrib/sssd.spec.in
