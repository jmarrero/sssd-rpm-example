-    if (dirname == NULL) {
-        return EIO;
+#ifdef HAVE_KRB5_CC_COLLECTION
+    krb5_ccache cckcc;
+    bool switch_to_cc = false;
+#endif
+
+    /* Set a restrictive umask, just in case we end up creating any file */
+    umask(077);
+
+    /* we create a new context here as the main process one may have been
