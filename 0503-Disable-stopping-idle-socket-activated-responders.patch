+++ b/src/man/sssd.conf.5.xml
@@ -706,7 +706,7 @@
                             or dbus activated.
                         </para>
                         <para>
-                            Default: 300
+                            Default: 0
                         </para>
                     </listitem>
                 </varlistentry>
